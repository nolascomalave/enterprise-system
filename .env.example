# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/enterprise_system

# JWT
JWT_SECRET=change-me-to-a-random-secret-of-at-least-32-bytes
JWT_ISSUER=enterprise-system

# Redis (rate limiting distribuido). Si se omite o falla, se usa memoria.
REDIS_URL=redis://localhost:6379/0

# HTTP
PORT=8080
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
GIN_MODE=debug

# Document storage
DOCUMENT_STORAGE_DIR=./data/documents

# Platform administration
PLATFORM_ADMIN_KEY=change-me
