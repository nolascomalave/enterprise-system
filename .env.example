# Base de datos
DATABASE_URL=postgresql://usuario:password@localhost:5432/enterprise_system?sslmode=disable

# JWT
JWT_SECRET=una-cadena-aleatoria-de-minimo-32-bytes
JWT_ISSUER=enterprise-system

# Redis
REDIS_URL=redis://localhost:6379/0

# Servidor
PORT=8080
GIN_MODE=debug  # o release para producción
COOKIE_SECURE=false  # false en local (HTTP), true en prod (HTTPS)

# CORS (para cuando conectes Next.js/Flutter)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Uploads
DOCUMENT_STORAGE_DIR=./data/documents

# Admin de plataforma (para crear first-party clients)
PLATFORM_ADMIN_KEY=tu-clave-administrativa-secreta